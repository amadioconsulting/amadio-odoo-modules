<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_recurrence_template_list" model="ir.ui.view">
        <field name="name">project.task.recurrence.template.list</field>
        <field name="model">project.task.recurrence.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="stage_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="recurrence_type"/>
                <field name="day_of_week"/>
                <field name="day_of_month"/>
                <field name="interval"/>
                <field name="custom_cron"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_recurrence_template_form" model="ir.ui.view">
        <field name="name">project.task.recurrence.template.form</field>
        <field name="model">project.task.recurrence.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="stage_id"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="description"/>
                            <field name="recurrence_type"/>
                        </group>
                        <group>
                            <field name="day_of_week"/>
                            <field name="day_of_month"/>
                            <field name="interval"/>
                            <field name="custom_cron"/>
                            <field name="next_run_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_task_recurrence_template_search" model="ir.ui.view">
        <field name="name">project.task.recurrence.template.search</field>
        <field name="model">project.task.recurrence.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_project_task_recurrence_template" model="ir.actions.act_window">
        <field name="name">Project Task Recurrence Template</field>
        <field name="res_model">project.task.recurrence.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>