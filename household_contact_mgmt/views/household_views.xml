<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_household_list" model="ir.ui.view">
        <field name="name">household.list</field>
        <field name="model">household.household</field>
        <field name="arch" type="xml">
            <list string="Households">
                <field name="display_name" string="Household"/>
                <field name="family_name"/>
                <field name="primary_partner_id"/>
                <field name="city" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="anniversary_date" optional="hide"/>
                <field name="membership_since" optional="hide"/>
                <button name="action_view_members" type="object"
                        string="Members" icon="fa-users"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_household_form" model="ir.ui.view">
        <field name="name">household.form</field>
        <field name="model">household.household</field>
        <field name="arch" type="xml">
            <form string="Household">
                <sheet>
                    <div class="oe_title">
                        <label for="family_name" string="Family Name"/>
                        <h1>
                            <field name="family_name" placeholder="e.g. Smith"/>
                        </h1>
                        <div class="o_row">
                            <label for="display_name" string="Salutation:"/>
                            <field name="display_name" readonly="1"
                                   style="font-weight:600;color:#0f3460;"/>
                        </div>
                    </div>

                    <group>
                        <group string="Salutation">
                            <field name="salutation_override"
                                   placeholder="Leave blank to auto-generate"/>
                        </group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>

                    <group string="Address">
                        <field name="street" placeholder="Street Address"/>
                        <field name="street2" placeholder="Unit / Suite"/>
                        <field name="city"/>
                        <field name="state_id"/>
                        <field name="zip"/>
                        <field name="country_id"/>
                    </group>

                    <group string="Key Dates">
                        <field name="anniversary_date"/>
                        <field name="membership_since"/>
                    </group>

                    <notebook>
                        <page string="Members" name="members">
                            <field name="partner_ids" context="{'default_household_id': active_id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="household_role"/>
                                    <field name="title" optional="show"/>
                                    <field name="phone" optional="show"/>
                                    <field name="email" optional="show"/>
                                    <field name="birth_date" optional="hide"/>
                                    <field name="baptism_date" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this household…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_household_search" model="ir.ui.view">
        <field name="name">household.search</field>
        <field name="model">household.household</field>
        <field name="arch" type="xml">
            <search>
                <field name="family_name"/>
                <field name="display_name"/>
                <field name="city"/>
                <field name="primary_partner_id"/>
                <field name="partner_ids" string="Any Member"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Has Anniversary This Month" name="anniversary_month"
                        domain="[('anniversary_date','!=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="City" name="groupby_city" context="{'group_by': 'city'}"/>
                    <filter string="Country" name="groupby_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_household" model="ir.actions.act_window">
        <field name="name">Households</field>
        <field name="res_model">household.household</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_household_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first household</p>
            <p>Group family members under a single address with auto-generated combined salutations.</p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_household_root"
              name="Households"
              parent="contacts.menu_contacts"
              action="action_household"
              sequence="15"
              icon="fa-home"/>

</odoo>
