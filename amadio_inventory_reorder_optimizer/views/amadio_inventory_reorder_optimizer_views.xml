<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inventory_forecast_list" model="ir.ui.view">
        <field name="name">inventory.forecast.list</field>
        <field name="model">inventory.forecast</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="avg_daily_demand"/>
                <field name="lead_time_days"/>
                <field name="safety_stock_days"/>
                <field name="suggested_reorder_point"/>
                <field name="suggested_max_qty"/>
                <field name="last_computed_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_forecast_form" model="ir.ui.view">
        <field name="name">inventory.forecast.form</field>
        <field name="model">inventory.forecast</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="warehouse_id"/>
                            <field name="avg_daily_demand"/>
                            <field name="lead_time_days"/>
                        </group>
                        <group>
                            <field name="safety_stock_days"/>
                            <field name="suggested_reorder_point"/>
                            <field name="suggested_max_qty"/>
                            <field name="last_computed_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_inventory_forecast_search" model="ir.ui.view">
        <field name="name">inventory.forecast.search</field>
        <field name="model">inventory.forecast</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <filter name="filter_status_healthy" string="Healthy" domain="[('status','=','healthy')]"/>
                <filter name="filter_status_watch" string="Watch" domain="[('status','=','watch')]"/>
                <filter name="filter_status_critical" string="Critical" domain="[('status','=','critical')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_inventory_forecast_kanban" model="ir.ui.view">
        <field name="name">inventory.forecast.kanban</field>
        <field name="model">inventory.forecast</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_inventory_forecast" model="ir.actions.act_window">
        <field name="name">Inventory Forecast</field>
        <field name="res_model">inventory.forecast</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>