<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Donation Receipt Report Template -->
        <record id="report_donation_receipt" model="ir.actions.report">
            <field name="name">Donation Receipt</field>
            <field name="model">donation.donation</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">nonprofit_donation_mgmt.report_donation_receipt_template</field>
            <field name="report_file">nonprofit_donation_mgmt.report_donation_receipt_template</field>
            <field name="print_report_name">'Donation Receipt - %s' % object.reference</field>
            <field name="binding_model_id" ref="model_donation_donation" />
            <field name="binding_type">report</field>
        </record>

        <!-- QWeb Template for Donation Receipt PDF -->
        <template id="report_donation_receipt_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Header -->
                            <div style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #333; padding-bottom: 20px;">
                                <h1 style="margin: 0; color: #1f4788;">
                                    <t t-esc="o.env.company.name" />
                                </h1>
                                <p style="margin: 5px 0; color: #666;">
                                    <t t-esc="o.env.company.street" /> <t t-esc="o.env.company.street2" /><br />
                                    <t t-esc="o.env.company.city" />, <t t-esc="o.env.company.state_id.name" /> <t t-esc="o.env.company.zip" /><br />
                                    Phone: <t t-esc="o.env.company.phone" /> | Email: <t t-esc="o.env.company.email" />
                                </p>
                            </div>

                            <!-- Receipt Title -->
                            <div style="text-align: center; margin-bottom: 30px;">
                                <h2 style="margin: 10px 0; color: #333;">OFFICIAL DONATION RECEIPT</h2>
                                <p style="margin: 5px 0; font-weight: bold; color: #d9534f;">For Income Tax Purposes</p>
                                <p style="margin: 5px 0; color: #666;">Canada Revenue Agency Authorized</p>
                            </div>

                            <!-- Receipt Details -->
                            <table style="width: 100%; margin-bottom: 20px;">
                                <tr>
                                    <td style="width: 50%; padding: 10px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                        <strong>Receipt Number:</strong>
                                    </td>
                                    <td style="width: 50%; padding: 10px; border: 1px solid #ddd;">
                                        <t t-esc="o.receipt_number" />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 50%; padding: 10px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                        <strong>Date of Receipt:</strong>
                                    </td>
                                    <td style="width: 50%; padding: 10px; border: 1px solid #ddd;">
                                        <t t-esc="o.date.strftime('%B %d, %Y')" />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 50%; padding: 10px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                        <strong>Reference Number:</strong>
                                    </td>
                                    <td style="width: 50%; padding: 10px; border: 1px solid #ddd;">
                                        <t t-esc="o.reference" />
                                    </td>
                                </tr>
                            </table>

                            <!-- Donor Information -->
                            <div style="margin-bottom: 20px;">
                                <h3 style="margin-bottom: 10px; color: #333;">DONOR INFORMATION</h3>
                                <p style="margin: 5px 0;">
                                    <strong>Name:</strong> <t t-esc="o.donor_id.name" />
                                </p>
                                <p style="margin: 5px 0;">
                                    <strong>Address:</strong> <t t-esc="o.donor_id.street or ''" />
                                    <t t-if="o.donor_id.street2"> <t t-esc="o.donor_id.street2" /></t>
                                </p>
                                <p style="margin: 5px 0;">
                                    <t t-esc="(o.donor_id.city or '') + ', ' + (o.donor_id.state_id.name or '') + ' ' + (o.donor_id.zip or '')" />
                                </p>
                                <t t-if="o.donor_id.country_id">
                                    <p style="margin: 5px 0;">
                                        <strong>Country:</strong> <t t-esc="o.donor_id.country_id.name" />
                                    </p>
                                </t>
                            </div>

                            <!-- Donation Details -->
                            <div style="margin-bottom: 30px; padding: 15px; background-color: #f0f8ff; border-left: 4px solid #1f4788;">
                                <h3 style="margin-bottom: 15px; color: #333;">DONATION DETAILS</h3>
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="padding: 8px; width: 50%;">
                                            <strong>Donation Date:</strong>
                                        </td>
                                        <td style="padding: 8px; width: 50%;">
                                            <t t-esc="o.date.strftime('%B %d, %Y')" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; width: 50%;">
                                            <strong>Payment Method:</strong>
                                        </td>
                                        <td style="padding: 8px; width: 50%;">
                                            <t t-esc="dict(o._fields['payment_method'].selection).get(o.payment_method, o.payment_method)" />
                                            <t t-if="o.payment_method == 'cheque'"> - Cheque #<t t-esc="o.cheque_number" /></t>
                                        </td>
                                    </tr>
                                    <t t-if="o.fund_id">
                                        <tr>
                                            <td style="padding: 8px; width: 50%;">
                                                <strong>Fund/Purpose:</strong>
                                            </td>
                                            <td style="padding: 8px; width: 50%;">
                                                <t t-esc="o.fund_id.name" />
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="o.campaign_id">
                                        <tr>
                                            <td style="padding: 8px; width: 50%;">
                                                <strong>Campaign:</strong>
                                            </td>
                                            <td style="padding: 8px; width: 50%;">
                                                <t t-esc="o.campaign_id.name" />
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>

                            <!-- Amount -->
                            <div style="margin-bottom: 30px; padding: 20px; background-color: #fff3cd; border: 2px solid #ffc107; text-align: center;">
                                <p style="margin: 0; font-size: 18px; color: #333;">
                                    <strong>Amount Donated:</strong>
                                </p>
                                <p style="margin: 10px 0; font-size: 28px; color: #1f4788; font-weight: bold;">
                                    <t t-esc="'{:,.2f}'.format(o.amount)" /> <t t-esc="o.currency_id.symbol" />
                                </p>
                                <p style="margin: 0; font-size: 14px; color: #666;">
                                    (Amount in words will be printed by organization)
                                </p>
                            </div>

                            <!-- Tax Deduction Notice -->
                            <div style="margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                <p style="margin: 0; font-size: 11px; color: #666; line-height: 1.6;">
                                    <strong>Tax Deduction Notice:</strong> This receipt acknowledges a donation made to <t t-esc="o.env.company.name" />.
                                    The amount noted above is tax-deductible as allowed by Canadian income tax law.
                                    Please retain this receipt for your records. For questions regarding donation tax treatment,
                                    please consult with the Canada Revenue Agency or a tax professional.
                                </p>
                            </div>

                            <!-- Signature Line -->
                            <div style="margin-top: 40px; border-top: 1px solid #ddd; padding-top: 20px;">
                                <p style="margin: 0;">
                                    <t t-esc="o.env.company.name" />
                                </p>
                                <p style="margin: 0; margin-top: 40px; border-top: 1px solid #333; width: 300px;">
                                    Authorized Representative Signature
                                </p>
                                <p style="margin: 0; margin-top: 10px; font-size: 11px; color: #666;">
                                    <t t-esc="o.env.company.name" /> is a registered Canadian charity.
                                </p>
                            </div>

                            <!-- Footer -->
                            <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 11px; color: #999; text-align: center;">
                                <p>This receipt was generated by Nonprofit Donation Management for Odoo</p>
                                <p>Generated on <t t-esc="datetime.datetime.now().strftime('%B %d, %Y at %H:%M')" /></p>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Year-End Donation Statement Report -->
        <record id="report_donation_year_end" model="ir.actions.report">
            <field name="name">Year-End Donation Statement</field>
            <field name="model">donation.donation</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">nonprofit_donation_mgmt.report_donation_year_end_template</field>
            <field name="report_file">nonprofit_donation_mgmt.report_donation_year_end_template</field>
            <field name="print_report_name">'Year-End Statement'</field>
        </record>

        <!-- QWeb Template for Year-End Statement -->
        <template id="report_donation_year_end_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #333; padding-bottom: 20px;">
                            <h1 style="margin: 0; color: #1f4788;">
                                <t t-esc="o.env.company.name" />
                            </h1>
                            <h2 style="margin: 10px 0; color: #333;">YEAR-END DONATION STATEMENT</h2>
                        </div>

                        <!-- Donor and Year Info -->
                        <div style="margin-bottom: 20px;">
                            <p style="margin: 5px 0;">
                                <strong>Statement For:</strong> <t t-esc="o[0].donor_id.name if o else 'Donor'" />
                            </p>
                            <p style="margin: 5px 0;">
                                <strong>Tax Year:</strong> January 1 - December 31, <t t-esc="context.get('year', datetime.datetime.now().year)" />
                            </p>
                            <p style="margin: 5px 0;">
                                <strong>Statement Date:</strong> <t t-esc="datetime.datetime.now().strftime('%B %d, %Y')" />
                            </p>
                        </div>

                        <!-- Donations Table -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <thead>
                                <tr style="background-color: #1f4788; color: white;">
                                    <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Date</th>
                                    <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Reference</th>
                                    <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Fund/Purpose</th>
                                    <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o" t-as="donation">
                                    <tr style="background-color: #f9f9f9;" t-if="donation_parity % 2 == 0">
                                        <td style="padding: 10px; border: 1px solid #ddd;">
                                            <t t-esc="donation.date.strftime('%Y-%m-%d')" />
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #ddd;">
                                            <t t-esc="donation.reference" />
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #ddd;">
                                            <t t-esc="donation.fund_id.name if donation.fund_id else 'General'" />
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">
                                            <t t-esc="'{:,.2f}'.format(donation.amount)" />
                                        </td>
                                    </tr>
                                    <tr style="background-color: white;" t-if="donation_parity % 2 == 1">
                                        <td style="padding: 10px; border: 1px solid #ddd;">
                                            <t t-esc="donation.date.strftime('%Y-%m-%d')" />
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #ddd;">
                                            <t t-esc="donation.reference" />
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #ddd;">
                                            <t t-esc="donation.fund_id.name if donation.fund_id else 'General'" />
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">
                                            <t t-esc="'{:,.2f}'.format(donation.amount)" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #1f4788; color: white; font-weight: bold;">
                                    <td colspan="3" style="padding: 10px; border: 1px solid #ddd; text-align: right;">TOTAL DONATIONS:</td>
                                    <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">
                                        <t t-esc="'{:,.2f}'.format(sum(o.mapped('amount')))" /> <t t-esc="o[0].currency_id.symbol if o else ''" />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Summary -->
                        <div style="margin-top: 30px; padding: 15px; background-color: #f0f8ff; border-left: 4px solid #1f4788;">
                            <p style="margin: 5px 0;">
                                <strong>Number of Donations:</strong> <t t-esc="len(o)" />
                            </p>
                            <p style="margin: 5px 0;">
                                <strong>Total Amount Donated:</strong> <t t-esc="'{:,.2f}'.format(sum(o.mapped('amount')))" /> <t t-esc="o[0].currency_id.symbol if o else ''" />
                            </p>
                        </div>

                        <!-- Tax Notice -->
                        <div style="margin-top: 20px; padding: 15px; border: 1px solid #ddd; background-color: #fff3cd; font-size: 11px; color: #333;">
                            <p style="margin: 0 0 10px 0;">
                                <strong>For Tax Purposes:</strong>
                            </p>
                            <p style="margin: 0;">
                                This statement summarizes all donations made to <t t-esc="o.env.company.name" /> during the tax year.
                                <t t-esc="o.env.company.name" /> is a registered Canadian charity. Individual donation receipts are
                                available upon request. Please retain this statement with your tax records.
                            </p>
                        </div>

                        <!-- Footer -->
                        <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 11px; color: #999; text-align: center;">
                            <p>Thank you for your generous support!</p>
                            <p>Generated by Nonprofit Donation Management for Odoo</p>
                        </div>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
