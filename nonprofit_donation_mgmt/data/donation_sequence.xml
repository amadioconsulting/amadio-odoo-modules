<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Donation Reference Numbers -->
        <record id="seq_donation_donation" model="ir.sequence">
            <field name="name">Donation Reference</field>
            <field name="code">donation.donation</field>
            <field name="prefix">DON-%(year)s-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="reset_on_cron">False</field>
        </record>

        <!-- Sequence for Receipt Numbers -->
        <record id="seq_donation_receipt" model="ir.sequence">
            <field name="name">Donation Receipt Number</field>
            <field name="code">donation.receipt</field>
            <field name="prefix">RCP-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="reset_on_cron">False</field>
        </record>

    </data>
</odoo>
