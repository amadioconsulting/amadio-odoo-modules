<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View for Donations -->
        <record id="donation_donation_tree" model="ir.ui.view">
            <field name="name">donation.donation.tree</field>
            <field name="model">donation.donation</field>
            <field name="arch" type="xml">
                <tree string="Donations" decoration-info="state == 'draft'" decoration-success="state == 'receipted'">
                    <field name="reference" />
                    <field name="date" />
                    <field name="donor_id" />
                    <field name="amount" sum="Total" />
                    <field name="payment_method" />
                    <field name="fund_id" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <!-- Form View for Donations -->
        <record id="donation_donation_form" model="ir.ui.view">
            <field name="name">donation.donation.form</field>
            <field name="model">donation.donation</field>
            <field name="arch" type="xml">
                <form string="Donation">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary" states="draft" />
                        <button name="action_generate_receipt" type="object" string="Generate Receipt" class="btn-primary" states="confirmed" />
                        <button name="action_print_receipt" type="object" string="Print Receipt" class="btn-secondary" states="receipted" />
                        <button name="action_post_to_accounting" type="object" string="Post to Accounting" class="btn-secondary" states="confirmed,receipted" />
                        <button name="action_view_accounting_entry" type="object" string="View GL Entry" class="btn-secondary" states="confirmed,receipted" attrs="{'invisible': [('move_id', '=', False)]}" />
                        <button name="action_set_to_draft" type="object" string="Reset to Draft" states="confirmed" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,receipted" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_accounting_entry" type="object" class="oe_stat_button" icon="fa-pencil-square-o" attrs="{'invisible': [('move_id', '=', False)]}">
                                <field string="GL Entry" name="move_id" widget="statinfo" />
                            </button>
                        </div>
                        <h1>
                            <field name="reference" readonly="1" />
                        </h1>
                        <group>
                            <group>
                                <field name="donor_id" required="1" />
                                <field name="date" required="1" />
                                <field name="amount" required="1" />
                                <field name="currency_id" invisible="1" />
                            </group>
                            <group>
                                <field name="payment_method" />
                                <field name="cheque_number" attrs="{'invisible': [('payment_method', '!=', 'cheque')]}" />
                                <field name="receipt_number" readonly="1" />
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="fund_id" />
                                <field name="campaign_id" />
                            </group>
                            <group>
                                <field name="journal_id" />
                                <field name="move_id" readonly="1" />
                            </group>
                        </group>
                        <group>
                            <field name="note" nolabel="1" />
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread" />
                        <field name="activity_ids" widget="mail_activity" />
                    </div>
                </form>
            </field>
        </record>

        <!-- Search View for Donations -->
        <record id="donation_donation_search" model="ir.ui.view">
            <field name="name">donation.donation.search</field>
            <field name="model">donation.donation</field>
            <field name="arch" type="xml">
                <search string="Search Donations">
                    <field name="reference" string="Reference or Donor" filter_domain="['|', ('reference', 'ilike', self), ('donor_id', 'ilike', self)]" />
                    <field name="donor_id" />
                    <field name="date" />
                    <field name="fund_id" />
                    <field name="campaign_id" />
                    <field name="payment_method" />
                    <field name="state" />
                    <separator />
                    <filter string="Draft" name="draft_filter" domain="[('state', '=', 'draft')]" />
                    <filter string="Confirmed" name="confirmed_filter" domain="[('state', '=', 'confirmed')]" />
                    <filter string="Receipted" name="receipted_filter" domain="[('state', '=', 'receipted')]" />
                    <separator />
                    <filter string="This Year" name="this_year" domain="[('date', '>=', datetime(datetime.now().year, 1, 1)), ('date', '&lt;=', datetime(datetime.now().year, 12, 31))]" />
                    <filter string="This Month" name="this_month" domain="[('date', '>=', datetime(datetime.now().year, datetime.now().month, 1))]" />
                    <separator />
                    <group expand="0" string="Group By">
                        <filter string="Donor" name="group_by_donor" context="{'group_by': 'donor_id'}" />
                        <filter string="Date" name="group_by_date" context="{'group_by': 'date'}" />
                        <filter string="Fund" name="group_by_fund" context="{'group_by': 'fund_id'}" />
                        <filter string="Payment Method" name="group_by_method" context="{'group_by': 'payment_method'}" />
                        <filter string="State" name="group_by_state" context="{'group_by': 'state'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Pivot View for Donations -->
        <record id="donation_donation_pivot" model="ir.ui.view">
            <field name="name">donation.donation.pivot</field>
            <field name="model">donation.donation</field>
            <field name="arch" type="xml">
                <pivot string="Donations Analysis">
                    <field name="state" type="row" />
                    <field name="fund_id" type="row" />
                    <field name="date" type="col" interval="month" />
                    <field name="amount" type="measure" />
                </pivot>
            </field>
        </record>

        <!-- Dashboard/Kanban-style View -->
        <record id="donation_donation_kanban" model="ir.ui.view">
            <field name="name">donation.donation.kanban</field>
            <field name="model">donation.donation</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_columns" default_group_by="state">
                    <field name="id" />
                    <field name="reference" />
                    <field name="donor_id" />
                    <field name="amount" />
                    <field name="date" />
                    <field name="state" />
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_content">
                                    <strong><field name="reference" /></strong><br />
                                    <field name="donor_id" /><br />
                                    <field name="amount" widget="monetary" /><br />
                                    <small><field name="date" /></small>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action for Donations -->
        <record id="donation_donation_action" model="ir.actions.act_window">
            <field name="name">Donations</field>
            <field name="res_model">donation.donation</field>
            <field name="view_mode">tree,form,pivot,kanban</field>
            <field name="search_view_id" ref="donation_donation_search" />
            <field name="context">{'search_default_receipted_filter': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No donations recorded yet!</p>
                <p>Create a new donation record to track gifts from donors.</p>
            </field>
        </record>

        <!-- Menu for Donations -->
        <menuitem id="donation_donation_menu" name="Donations" action="donation_donation_action" web_icon="nonprofit_donation_mgmt,static/description/icon.png" sequence="1" />

    </data>
</odoo>
