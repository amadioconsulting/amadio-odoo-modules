<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View for Funds -->
        <record id="donation_fund_tree" model="ir.ui.view">
            <field name="name">donation.fund.tree</field>
            <field name="model">donation.fund</field>
            <field name="arch" type="xml">
                <tree string="Donation Funds">
                    <field name="name" />
                    <field name="code" />
                    <field name="total_amount" sum="Total" />
                    <field name="donation_count" sum="Count" />
                    <field name="active" />
                </tree>
            </field>
        </record>

        <!-- Form View for Funds -->
        <record id="donation_fund_form" model="ir.ui.view">
            <field name="name">donation.fund.form</field>
            <field name="model">donation.fund</field>
            <field name="arch" type="xml">
                <form string="Donation Fund">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_donations" class="oe_stat_button" icon="fa-heart">
                                <field string="Donations" name="donation_count" widget="statinfo" />
                            </button>
                            <button type="action" name="nonprofit_donation_mgmt.donation_donation_action" class="oe_stat_button" icon="fa-money">
                                <field string="Raised" name="total_amount" widget="statinfo" />
                            </button>
                        </div>
                        <h1>
                            <field name="name" />
                        </h1>
                        <group>
                            <group>
                                <field name="code" />
                                <field name="active" />
                            </group>
                            <group>
                                <field name="account_id" />
                            </group>
                        </group>
                        <group>
                            <field name="description" nolabel="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for Funds -->
        <record id="donation_fund_search" model="ir.ui.view">
            <field name="name">donation.fund.search</field>
            <field name="model">donation.fund</field>
            <field name="arch" type="xml">
                <search string="Search Funds">
                    <field name="name" />
                    <field name="code" />
                    <separator />
                    <filter string="Active" name="active_filter" domain="[('active', '=', True)]" />
                    <filter string="Inactive" name="inactive_filter" domain="[('active', '=', False)]" />
                </search>
            </field>
        </record>

        <!-- Action for Funds -->
        <record id="donation_fund_action" model="ir.actions.act_window">
            <field name="name">Donation Funds</field>
            <field name="res_model">donation.fund</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="donation_fund_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No funds defined yet!</p>
                <p>Create donation funds to organize and track donations by purpose.</p>
            </field>
        </record>

        <!-- Menu for Funds -->
        <menuitem id="donation_fund_menu" name="Funds" action="donation_fund_action" parent="donation_donation_menu" sequence="2" />

    </data>
</odoo>
