<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_scorecard_list" model="ir.ui.view">
        <field name="name">vendor.scorecard.list</field>
        <field name="model">vendor.scorecard</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="period"/>
                <field name="overall_score"/>
                <field name="delivery_score"/>
                <field name="quality_score"/>
                <field name="price_score"/>
                <field name="service_score"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_scorecard_form" model="ir.ui.view">
        <field name="name">vendor.scorecard.form</field>
        <field name="model">vendor.scorecard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="period"/>
                        <h1><field name="period"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="overall_score"/>
                            <field name="delivery_score"/>
                            <field name="quality_score"/>
                        </group>
                        <group>
                            <field name="price_score"/>
                            <field name="service_score"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vendor_scorecard_search" model="ir.ui.view">
        <field name="name">vendor.scorecard.search</field>
        <field name="model">vendor.scorecard</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <record id="action_vendor_scorecard" model="ir.actions.act_window">
        <field name="name">Vendor Scorecard</field>
        <field name="res_model">vendor.scorecard</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_vendor_scorecard_criterion_list" model="ir.ui.view">
        <field name="name">vendor.scorecard.criterion.list</field>
        <field name="model">vendor.scorecard.criterion</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="weight"/>
                <field name="score_type"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_scorecard_criterion_form" model="ir.ui.view">
        <field name="name">vendor.scorecard.criterion.form</field>
        <field name="model">vendor.scorecard.criterion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="weight"/>
                        </group>
                        <group>
                            <field name="score_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vendor_scorecard_criterion_search" model="ir.ui.view">
        <field name="name">vendor.scorecard.criterion.search</field>
        <field name="model">vendor.scorecard.criterion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_vendor_scorecard_criterion" model="ir.actions.act_window">
        <field name="name">Vendor Scorecard Criterion</field>
        <field name="res_model">vendor.scorecard.criterion</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>