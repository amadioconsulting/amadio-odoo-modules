<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_bank_deposit" model="ir.ui.view">
        <field name="name">res.config.settings.bank.deposit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account']" position="after">
                <h2>Bank Deposit Slip</h2>
                <div class="row mt16 o_settings_container" id="bank_deposit_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <div class="text-muted">
                                These values are printed on your deposit slip PDF.
                            </div>
                            <div class="content-group mt8">
                                <div class="row">
                                    <label for="deposit_bank_name" class="col-lg-4 o_light_label"/>
                                    <field name="deposit_bank_name" class="col-lg-8"
                                           placeholder="e.g. Royal Bank of Canada"/>
                                </div>
                                <div class="row">
                                    <label for="deposit_bank_institution" class="col-lg-4 o_light_label"/>
                                    <field name="deposit_bank_institution" class="col-lg-8"
                                           placeholder="e.g. 003"/>
                                </div>
                                <div class="row">
                                    <label for="deposit_bank_transit" class="col-lg-4 o_light_label"/>
                                    <field name="deposit_bank_transit" class="col-lg-8"
                                           placeholder="e.g. 04820"/>
                                </div>
                                <div class="row">
                                    <label for="deposit_bank_account" class="col-lg-4 o_light_label"/>
                                    <field name="deposit_bank_account" class="col-lg-8"
                                           placeholder="e.g. 1234567"/>
                                </div>
                                <div class="row">
                                    <label for="deposit_slip_footer" class="col-lg-4 o_light_label"/>
                                    <field name="deposit_slip_footer" class="col-lg-8"
                                           placeholder="Optional footer note on deposit slips"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
