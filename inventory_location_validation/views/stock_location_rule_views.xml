<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View for Stock Location Rule -->
        <record id="stock_location_rule_tree" model="ir.ui.view">
            <field name="name">stock.location.rule.tree</field>
            <field name="model">stock.location.rule</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="product_category_id" />
                    <field name="location_id" />
                    <field name="action" />
                    <field name="active" widget="boolean" />
                    <field name="note" />
                </tree>
            </field>
        </record>

        <!-- Form View for Stock Location Rule -->
        <record id="stock_location_rule_form" model="ir.ui.view">
            <field name="name">stock.location.rule.form</field>
            <field name="model">stock.location.rule</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="product_category_id" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="product_category_id" />
                                <field name="location_id" />
                            </group>
                            <group>
                                <field name="action" />
                                <field name="active" />
                            </group>
                        </group>
                        <group>
                            <field name="note" placeholder="e.g., Hazmat storage area, Temperature controlled zone" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for Stock Location Rule -->
        <record id="stock_location_rule_search" model="ir.ui.view">
            <field name="name">stock.location.rule.search</field>
            <field name="model">stock.location.rule</field>
            <field name="arch" type="xml">
                <search>
                    <field name="product_category_id" />
                    <field name="location_id" />
                    <field name="action" />
                    <separator />
                    <filter name="active" string="Active" domain="[('active', '=', True)]" />
                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]" />
                    <separator />
                    <filter name="warn_only" string="Warn Only" domain="[('action', '=', 'warn')]" />
                    <filter name="block_only" string="Block Only" domain="[('action', '=', 'block')]" />
                </search>
            </field>
        </record>

        <!-- Action for Stock Location Rule -->
        <record id="stock_location_rule_action" model="ir.actions.act_window">
            <field name="name">Location Rules</field>
            <field name="res_model">stock.location.rule</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="stock_location_rule_tree" />
            <field name="search_view_id" ref="stock_location_rule_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new location rule
                </p>
                <p>
                    Location rules restrict products in specific categories from being moved to certain warehouse locations.
                    Use "Warn" for informational alerts or "Block" to prevent validation entirely.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem
            id="menu_stock_location_rule"
            name="Location Rules"
            parent="stock.menu_stock_config"
            action="stock_location_rule_action"
            sequence="25"
        />

    </data>
</odoo>
