<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View for Location Validation Wizard -->
        <record id="stock_location_validation_wizard_form" model="ir.ui.view">
            <field name="name">stock.location.validation.wizard.form</field>
            <field name="model">stock.location.validation.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="alert alert-warning" role="alert">
                            <strong>Location Validation Warning</strong>
                        </div>
                        <group>
                            <field name="picking_id" readonly="True" />
                        </group>
                        <group>
                            <field name="violation_text" readonly="True" widget="text" nolabel="True" />
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm and Validate" class="btn-primary" />
                        <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
