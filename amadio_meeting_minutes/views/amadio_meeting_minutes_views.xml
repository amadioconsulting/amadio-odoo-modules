<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meeting_minutes_list" model="ir.ui.view">
        <field name="name">meeting.minutes.list</field>
        <field name="model">meeting.minutes</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_id"/>
                <field name="title"/>
                <field name="date"/>
                <field name="facilitator_id"/>
                <field name="attendee_ids" widget="many2many_tags"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_minutes_form" model="ir.ui.view">
        <field name="name">meeting.minutes.form</field>
        <field name="model">meeting.minutes</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="date"/>
                            <field name="facilitator_id"/>
                            <field name="attendee_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="agenda"/>
                            <field name="decisions"/>
                            <field name="summary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Action Items" name="action_item_ids">
                            <field name="action_item_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meeting_minutes_search" model="ir.ui.view">
        <field name="name">meeting.minutes.search</field>
        <field name="model">meeting.minutes</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_id"/>
                <field name="title"/>
                <field name="facilitator_id"/>
                <filter name="filter_state_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_state_published" string="Published" domain="[('state','=','published')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_meeting_minutes_kanban" model="ir.ui.view">
        <field name="name">meeting.minutes.kanban</field>
        <field name="model">meeting.minutes</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_meeting_minutes" model="ir.actions.act_window">
        <field name="name">Meeting Minutes</field>
        <field name="res_model">meeting.minutes</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="view_meeting_action_item_list" model="ir.ui.view">
        <field name="name">meeting.action.item.list</field>
        <field name="model">meeting.action.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="minutes_id"/>
                <field name="owner_id"/>
                <field name="due_date"/>
                <field name="done"/>
                <field name="done_date"/>
                <field name="priority"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_action_item_form" model="ir.ui.view">
        <field name="name">meeting.action.item.form</field>
        <field name="model">meeting.action.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="description"/>
                        <h1><field name="description"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="minutes_id"/>
                            <field name="owner_id"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="done"/>
                            <field name="done_date"/>
                            <field name="priority"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meeting_action_item_search" model="ir.ui.view">
        <field name="name">meeting.action.item.search</field>
        <field name="model">meeting.action.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="owner_id"/>
            </search>
        </field>
    </record>

    <record id="action_meeting_action_item" model="ir.actions.act_window">
        <field name="name">Meeting Action Item</field>
        <field name="res_model">meeting.action.item</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>